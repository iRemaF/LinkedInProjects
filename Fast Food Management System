package fastfood;

public class Address {

    private String district; // District name
    private String street;
    private int houseNo;

    // Default constructor
    public Address() {
        this("", "", 0);
    }

    // Parameterized constructor
    public Address(String district, String street, int houseNo) {
        setDistrict(district);
        setStreet(street);
        setHouseNo(houseNo);
    }

    //**** Set and Get Methods ****

    // Gets the district value
    public String getDistrict() {
        return district;
    }

    // Sets the district value
    public void setDistrict(String district) {
        this.district = district;
    }

    // Gets the street value
    public String getStreet() {
        return street;
    }

    // Sets the street value
    public void setStreet(String street) {
        this.street = street;
    }

    // Gets the house number
    public int getHouseNo() {
        return houseNo;
    }

    // Sets the house number
    public void setHouseNo(int houseNo) {
        this.houseNo = houseNo;
    }

    @Override
    public String toString() {
        return String.format("%s  %s  %d", getDistrict(), getStreet(), getHouseNo());
    }
}
